# Copy this file to .env and fill in your values.
# python-dotenv will load it automatically if you call load_dotenv() at startup.

CERTINEXT_BASE_URL=https://us-api.certinext.io
CERTINEXT_TOKEN_URL=https://us-api.certinext.io/oauth/token
CERTINEXT_CLIENT_ID=your_client_id
CERTINEXT_CLIENT_SECRET=your_client_secret
CERTINEXT_SCOPE=                                           # leave empty if not required
